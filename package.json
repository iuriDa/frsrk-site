{
  "name": "frsrk-site-stage1-4",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build --webpack",
    "build:local": "NEXT_PUBLIC_SITE_URL=http://localhost:3002 next build --webpack",
    "prestart": "mkdir -p .next/standalone/.next/static .next/standalone/public && cp -R .next/static/. .next/standalone/.next/static/ && cp -R public/. .next/standalone/public/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build:local",
    "reset:mac": "rm -rf node_modules .next package-lock.json && npm cache verify && npm install --include=optional"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.15",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.2.9",
    "@tailwindcss/oxide-darwin-arm64": "4.3.1",
    "lightningcss-darwin-arm64": "1.32.0"
  }
}
